\par \pard\plain \s0\rtlch\af11\afs22\alang1025 \ltrch\lang3081\langfe1033\hich\af7\loch\sl256\slmult1\ql\widctlpar\faauto\sb0\sa160\hyphpar0\ltrpar\f7\fs22\lang3081\kerning1\cf0\dbch\af10\langfe1033\sl256\slmult1\li0\ri0\lin0\rin0\fi0\ltrpar{\rtlch\af16\ab \ltrch\lang1033\hich\af8\loch\lang1033\b\f8\loch
